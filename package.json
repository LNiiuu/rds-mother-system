{
  "name": "rds-mother-system",
  "version": "0.1.0",
  "description": "RDS —— 可独立部署的研发流程资产与本地记忆引擎（MARS）：零第三方依赖、离线可运行",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LNiiuu/rds-mother-system.git"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "rds": "bin/rds.mjs"
  },
  "files": [
    "bin/",
    "mars/src/",
    "mars/contracts/",
    "mars/config/role-routing.json",
    "mars/config/principals.example.json",
    "core/",
    "stacks/",
    "tooling/manifest/",
    "docs/install.md",
    "VERSION",
    "CHANGELOG.md",
    "docs/agents.md",
    "docs/rea.md"
  ],
  "scripts": {
    "doctor": "node bin/rds.mjs doctor",
    "config": "node tooling/config-check.mjs",
    "layers": "node tooling/layering-check.mjs",
    "baseline": "node tooling/baseline-capture.mjs --check",
    "docs:check": "node tooling/docs-check.mjs",
    "test": "node tooling/test-gate.mjs",
    "test:raw": "node --test \"mars/tests/**/*.test.js\"",
    "test:external": "node --test \"mars/tests/external/*.external.js\"",
    "test:gate-selfcheck": "node tooling/test-gate-selfcheck.mjs",
    "smoke": "bash tooling/ci-smoke.sh",
    "verify": "npm run doctor && npm run config && npm run layers && npm run docs:check && npm run test",
    "pack:check": "npm pack --dry-run",
    "demo:m9-m11": "node tooling/m9-m11-demo.cjs",
    "demo:m12": "node tooling/m12-multi-agent-demo.cjs",
    "demo:m15": "node tooling/m15-joint-demo.cjs"
  },
  "keywords": [
    "rds",
    "mars",
    "agent",
    "workflow",
    "local-first"
  ],
  "private": false
}
