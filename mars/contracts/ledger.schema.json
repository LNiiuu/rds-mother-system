{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mars/ledger.schema.json",
  "title": "MARS Usage Ledger (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "source", "sessions", "totals", "cost", "reconcile", "warnings"],
  "properties": {
    "version": { "const": "0.1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "const": "dsh-session" },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "path", "usage_events", "usage", "source_kind"],
        "properties": {
          "session_id": { "type": "string" },
          "path": { "type": "string" },
          "usage_events": { "type": "integer", "minimum": 0 },
          "source_kind": { "const": "dsh-session" },
          "model": { "type": "string" },
          "provider": { "type": "string" },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "output", "cacheRead", "cacheWrite", "total"],
            "properties": {
              "input": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 },
              "cacheRead": { "type": "integer", "minimum": 0 },
              "cacheWrite": { "type": "integer", "minimum": 0 },
              "total": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheWrite", "total", "cache_hit_rate"],
      "properties": {
        "input": { "type": "integer", "minimum": 0 },
        "output": { "type": "integer", "minimum": 0 },
        "cacheRead": { "type": "integer", "minimum": 0 },
        "cacheWrite": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "cache_hit_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "currency", "rates", "basis"],
      "properties": {
        "estimate": { "type": "number", "minimum": 0 },
        "currency": { "const": "USD" },
        "rates": { "type": "object", "additionalProperties": { "type": "number" } },
        "basis": { "type": "string" }
      }
    },
    "reconcile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["checked", "matched", "diff_ratio"],
      "properties": {
        "checked": { "type": "integer", "minimum": 0 },
        "matched": { "type": "integer", "minimum": 0 },
        "diff_ratio": { "type": "number", "minimum": 0 }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
