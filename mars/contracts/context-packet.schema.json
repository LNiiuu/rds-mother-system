{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mars/context-packet.schema.json",
  "title": "MARS Context Packet (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id", "manifest_id", "project_id", "task_id", "role_id",
    "created_at", "token_budget", "tokens_estimated", "estimate_label",
    "sections", "missing", "prohibited", "evidence_refs"
  ],
  "properties": {
    "packet_id": { "type": "string", "pattern": "^pkt_[0-9a-f]{12}$" },
    "manifest_id": { "type": "string", "pattern": "^man_[0-9a-f]{12}$" },
    "project_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "role_id": { "type": "string", "pattern": "^R[0-7]$" },
    "role_profile": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "compiler_version": { "type": "string" },
    "token_budget": { "type": "integer", "minimum": 0 },
    "tokens_estimated": { "type": "integer", "minimum": 0 },
    "estimate_label": { "const": "[ESTIMATE]" },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "token_estimate", "source_refs"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "enum": ["task", "state", "facts", "decisions", "knowledge", "prohibitions", "evidence"] },
          "content": { "type": "string" },
          "token_estimate": { "type": "integer", "minimum": 0 },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "truncated": { "type": "boolean" }
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "prohibited": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "kind"],
        "properties": {
          "ref": { "type": "string" },
          "kind": { "enum": ["file", "memory", "session", "issue"] },
          "note": { "type": "string" }
        }
      }
    }
  }
}
