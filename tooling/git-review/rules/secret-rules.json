{
  "schemaVersion": "1.0.0",
  "rules": [
    {
      "id": "SECRET-TOKEN-GITHUB",
      "category": "secret",
      "severity": "high",
      "regex": "gh[pousr]_[A-Za-z0-9]{20,}",
      "reason": "疑似 GitHub 访问令牌"
    },
    {
      "id": "SECRET-TOKEN-OPENAI",
      "category": "secret",
      "severity": "high",
      "regex": "sk-[A-Za-z0-9]{20,}",
      "reason": "疑似 API 令牌"
    },
    {
      "id": "SECRET-AWS-AKID",
      "category": "secret",
      "severity": "high",
      "regex": "AKIA[0-9A-Z]{16}",
      "reason": "疑似云访问密钥 ID"
    },
    {
      "id": "SECRET-PRIVATE-KEY",
      "category": "secret",
      "severity": "blocker",
      "regex": "-----BEGIN [A-Z ]*PRIVATE KEY-----",
      "reason": "私钥材料"
    },
    {
      "id": "SECRET-PASSWORD-ASSIGN",
      "category": "secret",
      "severity": "high",
      "regex": "(?i)(password|passwd|pwd)\\s*[:=]\\s*[^\\s]{6,}",
      "reason": "疑似口令赋值"
    },
    {
      "id": "SECRET-APIKEY-ASSIGN",
      "category": "secret",
      "severity": "high",
      "regex": "(?i)(api[_-]?key|secret[_-]?key|access[_-]?token)\\s*[:=]\\s*[A-Za-z0-9_\\-]{20,}",
      "reason": "疑似密钥/令牌赋值"
    },
    {
      "id": "SECRET-HIGH-ENTROPY",
      "category": "secret",
      "severity": "medium",
      "entropy": true,
      "minLength": 24,
      "threshold": 4.5,
      "reason": "高熵字符串，疑似密钥材料"
    },
    {
      "id": "PERSONAL-EMAIL",
      "category": "secret",
      "severity": "medium",
      "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "reason": "个人邮箱"
    },
    {
      "id": "PERSONAL-PHONE-CN",
      "category": "secret",
      "severity": "medium",
      "regex": "(?<![0-9])1[3-9][0-9]{9}(?![0-9])",
      "reason": "个人手机号"
    }
  ]
}
